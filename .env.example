# ===================================================================
# Mogali Footwear — Environment Variables Template
# Copy this file to backend/.env and populate with your own values.
# NEVER commit your real .env file with production passwords to GitHub.
# ===================================================================

# Port for the Node/Express backend server (Render automatically sets PORT in production)
PORT=5001

# MongoDB Connection String:
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/mogali_footwear

# Production MongoDB Atlas (Replace <username> and <password> with your Atlas credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mogali_footwear?retryWrites=true&w=majority

# Optional: Only needed if deploying frontend separately on Vercel/Netlify
# VITE_API_URL=https://your-backend-app.onrender.com/api
